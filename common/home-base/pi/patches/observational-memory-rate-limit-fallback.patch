+++ b/tests/model-fallback.test.ts
@@ -0,0 +1,186 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+import { RateLimitTracker, isRateLimitError, modelKey, rateLimitTracker } from "../src/model-fallback.js";
+import { Runtime } from "../src/runtime.js";
+
+describe("rate-limit detection", () => {
+	it("matches throttling-shaped provider errors", () => {
+		for (const message of [
+			"429 Too Many Requests",
+			"HTTP 429",
+			"rate_limit_error: this request would exceed your rate limit",
+			"Rate limit reached for gpt-5.6-sol",
+			"You exceeded your current quota",
+			"RESOURCE_EXHAUSTED",
+			"overloaded_error",
+		]) {
+			expect(isRateLimitError(message), message).toBe(true);
+		}
+	});
+
+	it("does not match configuration or context failures", () => {
+		for (const message of [
+			undefined,
+			"",
+			"prompt is too long: 5198507 tokens > 1000000 maximum",
+			"401 invalid api key",
+			"no API key or auth headers for provider \"cliproxyapi\"",
+			"model 4290 is not available",
+		]) {
+			expect(isRateLimitError(message), String(message)).toBe(false);
+		}
+	});
+});
+
+describe("RateLimitTracker", () => {
+	it("arms, expires, and reports cooldowns for the active model", () => {
+		let now = 1_000;
+		const tracker = new RateLimitTracker(60_000, () => now);
+		tracker.setActive("cliproxyapi/gpt-5.6-sol");
+
+		expect(tracker.noteError("prompt is too long")).toBe(false);
+		expect(tracker.isCoolingDown("cliproxyapi/gpt-5.6-sol")).toBe(false);
+
+		const generation = tracker.generation;
+		expect(tracker.noteError("429 Too Many Requests")).toBe(true);
+		expect(tracker.generation).toBe(generation + 1);
+		expect(tracker.isCoolingDown("cliproxyapi/gpt-5.6-sol")).toBe(true);
+		expect(tracker.active()).toEqual([{ key: "cliproxyapi/gpt-5.6-sol", remainingMs: 60_000 }]);
+
+		now += 60_001;
+		expect(tracker.isCoolingDown("cliproxyapi/gpt-5.6-sol")).toBe(false);
+		expect(tracker.active()).toEqual([]);
+	});
+
+	it("ignores errors when no model is active", () => {
+		const tracker = new RateLimitTracker();
+		expect(tracker.noteError("429 Too Many Requests")).toBe(false);
+	});
+
+	it("derives model keys only from complete provider/id pairs", () => {
+		expect(modelKey({ provider: "cliproxyapi", id: "gpt-5.6-sol" })).toBe("cliproxyapi/gpt-5.6-sol");
+		expect(modelKey({ provider: "cliproxyapi" })).toBeUndefined();
+		expect(modelKey(undefined)).toBeUndefined();
+	});
+});
+
+describe("Runtime fallback model resolution", () => {
+	const preferred = { provider: "cliproxyapi", id: "gpt-5.6-sol" };
+	const fallback = { provider: "cliproxyapi-claude", id: "claude-sonnet-5" };
+
+	function registry(auth?: (model: unknown) => unknown) {
+		return {
+			find: vi.fn((provider: string, id: string) => {
+				if (provider === preferred.provider && id === preferred.id) return preferred;
+				if (provider === fallback.provider && id === fallback.id) return fallback;
+				return undefined;
+			}),
+			getApiKeyAndHeaders: vi.fn(async (model: unknown) => auth?.(model) ?? { ok: true, apiKey: "key" }),
+		};
+	}
+
+	function configure(runtime: Runtime): void {
+		runtime.config = {
+			...runtime.config,
