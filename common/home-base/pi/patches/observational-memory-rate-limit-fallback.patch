index 0000000..fe7bbcd
--- /dev/null
+++ b/src/model-fallback.ts
@@ -0,0 +1,128 @@
+import type { ConfiguredModel } from "./config.js";
+
+/**
+ * Background memory work is pinned to one model by `observational-memory.model`
+ * so it never rides on an expensive foreground model. When that single provider
+ * account is rate limited (HTTP 429, quota exhausted, upstream overloaded),
+ * every consolidation attempt fails for as long as the limit holds and the
+ * session silently stops accumulating memory.
+ *
+ * `fallbackModels` lists alternates to use while the preferred model is cooling
+ * down. Only rate-limit-shaped failures arm a cooldown: auth errors,
+ * oversized prompts and tool misuse are configuration problems that a second
+ * model would fail on too, and hiding them behind a silent model switch is
+ * exactly the failure mode this extension already tries to avoid.
+ */
+export const DEFAULT_RATE_LIMIT_COOLDOWN_MS = 15 * 60_000;
+
+/**
+ * Matches the message shapes providers use for "you are being throttled":
+ * bare HTTP status text, OpenAI/Anthropic rate-limit and quota wording, gRPC
+ * RESOURCE_EXHAUSTED, and Anthropic's transient `overloaded_error`.
+ *
+ * Deliberately narrow: a false positive only parks one model for the cooldown
+ * window, but a match on, say, an auth error would mask a real misconfiguration.
+ */
+const RATE_LIMIT_PATTERN =
+	/(?:^|[^\d])429(?:[^\d]|$)|rate[\s_-]?limit|too[\s_-]?many[\s_-]?requests|quota|resource[\s_-]?exhausted|overloaded/i;
+
+export function isRateLimitError(message: string | undefined | null): boolean {
+	return typeof message === "string" && message.length > 0 && RATE_LIMIT_PATTERN.test(message);
+}
+
+/** Stable identity for a resolved or configured model: `provider/id`. */
+export function modelKey(model: { provider?: unknown; id?: unknown } | undefined | null): string | undefined {
+	if (!model) return undefined;
+	const provider = typeof model.provider === "string" ? model.provider : undefined;
+	const id = typeof model.id === "string" ? model.id : undefined;
+	if (!provider || !id) return undefined;
+	return `${provider}/${id}`;
+}
+
+export function configuredModelLabel(model: ConfiguredModel): string {
+	return `${model.provider}/${model.id}`;
+}
+
+/**
+ * Per-model rate-limit cooldowns shared by the resolver and the worker stream
+ * error path.
+ *
+ * The workers report stream failures from inside `agentLoop`, far from the
+ * `Runtime` instance that picked the model, so the tracker is a module
+ * singleton with the active model recorded at resolve time. Only one background
+ * consolidation runs at a time (`consolidationInFlight`), so a failure always
+ * belongs to the model resolved most recently.
+ */
+export class RateLimitTracker {
+	private cooldowns = new Map<string, number>();
+	private activeKey: string | undefined;
+	/**
+	 * Incremented whenever a new cooldown is armed. Callers that memoize a
+	 * resolved model for the duration of a consolidation run compare this to
+	 * detect that their cached choice may no longer be the right one.
+	 */
+	generation = 0;
+
+	constructor(
+		private cooldownMs: number = DEFAULT_RATE_LIMIT_COOLDOWN_MS,
+		private now: () => number = () => Date.now(),
+	) {}
+
+	setCooldownMs(cooldownMs: number): void {
+		if (Number.isFinite(cooldownMs) && cooldownMs > 0) this.cooldownMs = cooldownMs;
+	}
+
+	/** Record which model the next background request will use. */
+	setActive(key: string | undefined): void {
+		this.activeKey = key;
+	}
+
+	getActive(): string | undefined {
+		return this.activeKey;
+	}
+
+	/**
+	 * Arm a cooldown for `key` if `message` looks like a rate limit.
+	 * Returns true when a cooldown was armed.
+	 */
+	noteError(message: string | undefined | null, key: string | undefined = this.activeKey): boolean {
+		if (!key || !isRateLimitError(message)) return false;
+		this.cooldowns.set(key, this.now() + this.cooldownMs);
+		this.generation++;
+		return true;
+	}
+
+	isCoolingDown(key: string | undefined): boolean {
+		return this.remainingMs(key) > 0;
+	}
+
+	remainingMs(key: string | undefined): number {
+		if (!key) return 0;
+		const until = this.cooldowns.get(key);
+		if (until === undefined) return 0;
+		const remaining = until - this.now();
+		if (remaining <= 0) {
+			this.cooldowns.delete(key);
+			return 0;
+		}
+		return remaining;
+	}
+
+	/** Cooling-down models and their remaining time, for `/om:status`. */
+	active(): { key: string; remainingMs: number }[] {
+		const entries: { key: string; remainingMs: number }[] = [];
+		for (const key of Array.from(this.cooldowns.keys())) {
+			const remainingMs = this.remainingMs(key);
+			if (remainingMs > 0) entries.push({ key, remainingMs });
+		}
+		return entries;
+	}
+
+	clear(): void {
+		this.cooldowns.clear();
+		this.activeKey = undefined;
+		this.generation++;
+	}
+}
+
+export const rateLimitTracker = new RateLimitTracker();
