{{#themegen
let local.custom_bg = mix(color.dark.tertiary_container, color.dark.surface_container_low, 0.300000, hex, hex)
let local.tool_pending_bg = mix(color.dark.secondary_container, color.dark.surface_container_low, 0.300000, hex, hex)
let local.tool_success_bg = mix(base16.dark.base0B, color.dark.surface_container_low, 0.180000, hex, hex)
let local.tool_error_bg = mix(base16.dark.base08, color.dark.surface_container_low, 0.180000, hex, hex)
}}
{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "themegen-dark",
  "colors": {
    "accent": "{{color.dark.primary}}",
    "border": "{{color.dark.outline_variant}}",
    "borderAccent": "{{color.dark.primary}}",
    "borderMuted": "{{color.dark.surface_container_highest}}",
    "success": "{{base16.dark.base0B}}",
    "error": "{{base16.dark.base08}}",
    "warning": "{{base16.dark.base0A}}",
    "muted": "{{color.dark.on_surface_variant}}",
    "dim": "{{color.dark.outline}}",
    "text": "",
    "thinkingText": "{{syntax.dark.comment}}",
    "selectedBg": "{{color.dark.surface_container_high}}",
    "scrollbarTrack": "{{color.dark.surface_container_high}}",
    "scrollbarThumb": "{{color.dark.outline}}",
    "searchMatchBg": "{{color.dark.secondary_container}}",
    "searchMatchText": "{{color.dark.on_secondary_container}}",
    "userMessageBg": "{{color.dark.surface_container}}",
    "userMessageText": "{{color.dark.on_surface}}",
    "customMessageBg": "{{local.custom_bg}}",
    "customMessageText": "{{color.dark.on_surface}}",
    "customMessageLabel": "{{color.dark.tertiary}}",
    "toolPendingBg": "{{local.tool_pending_bg}}",
    "toolSuccessBg": "{{local.tool_success_bg}}",
    "toolErrorBg": "{{local.tool_error_bg}}",
    "toolTitle": "{{color.dark.primary}}",
    "toolOutput": "{{color.dark.on_surface_variant}}",
    "mdHeading": "{{color.dark.primary}}",
    "mdLink": "{{syntax.dark.link}}",
    "mdLinkUrl": "{{color.dark.on_surface_variant}}",
    "mdCode": "{{base16.dark.base0C}}",
    "mdCodeBlock": "",
    "mdCodeBlockBorder": "{{color.dark.outline_variant}}",
    "mdQuote": "{{color.dark.on_surface_variant}}",
    "mdQuoteBorder": "{{color.dark.outline}}",
    "mdHr": "{{color.dark.outline_variant}}",
    "mdListBullet": "{{color.dark.primary}}",
    "toolDiffAdded": "{{base16.dark.base0B}}",
    "toolDiffRemoved": "{{base16.dark.base08}}",
    "toolDiffContext": "{{color.dark.on_surface_variant}}",
    "syntaxComment": "{{syntax.dark.comment}}",
    "syntaxKeyword": "{{syntax.dark.keyword}}",
    "syntaxFunction": "{{syntax.dark.function}}",
    "syntaxVariable": "{{syntax.dark.variable}}",
    "syntaxString": "{{syntax.dark.string}}",
    "syntaxNumber": "{{syntax.dark.number}}",
    "syntaxType": "{{syntax.dark.type}}",
    "syntaxOperator": "{{syntax.dark.operator}}",
    "syntaxPunctuation": "{{syntax.dark.punctuation}}",
    "thinkingOff": "{{color.dark.outline}}",
    "thinkingMinimal": "{{base16.dark.base0C}}",
    "thinkingLow": "{{base16.dark.base0D}}",
    "thinkingMedium": "{{base16.dark.base0E}}",
    "thinkingHigh": "{{base16.dark.base0A}}",
    "thinkingXhigh": "{{base16.dark.base09}}",
    "thinkingMax": "{{base16.dark.base08}}",
    "bashMode": "{{base16.dark.base0A}}"
  }
}
